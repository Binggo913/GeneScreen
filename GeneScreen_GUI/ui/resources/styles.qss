/*
 * GeneScreen 1.0 - 全局样式表
 * 
 * 颜色方案:
 * - 主色: #667eea (紫蓝色)
 * - 辅助色: #764ba2 (紫色)
 * - 背景: #f5f7fa
 * - 文字: #333333
 * - 次要文字: #666666
 */

/* ==================== 全局样式 ==================== */

QWidget {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    font-size: 13px;
}

QMainWindow {
    background: #f5f7fa;
}

/* ==================== 侧边栏 ==================== */

#sidebar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #667eea, stop:1 #764ba2);
    border: none;
}

#sidebarTitle {
    font-size: 24px;
    font-weight: bold;
    color: white;
    padding: 10px;
}

#sidebarVersion {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.7);
}

#sidebarLine {
    background: rgba(255, 255, 255, 0.2);
    max-height: 1px;
    margin: 10px 0;
}

/* ==================== 导航按钮 ==================== */

#navButton, #navButtonSecondary {
    background: transparent;
    border: none;
    border-radius: 8px;
    color: rgba(255, 255, 255, 0.8);
    font-size: 14px;
    text-align: left;
    padding: 12px 15px;
    min-height: 45px;
}

#navButton:hover, #navButtonSecondary:hover {
    background: rgba(255, 255, 255, 0.15);
    color: white;
}

#navButton:checked {
    background: rgba(255, 255, 255, 0.25);
    color: white;
    font-weight: bold;
}

#navButton:pressed {
    background: rgba(255, 255, 255, 0.3);
}

/* ==================== 内容区域 ==================== */

#contentArea {
    background: #f5f7fa;
}

#pageStack {
    background: #f5f7fa;
}

/* ==================== 卡片样式 ==================== */

.card {
    background: white;
    border-radius: 12px;
    padding: 20px;
    border: 1px solid #e0e0e0;
}

.card:hover {
    border-color: #667eea;
    box-shadow: 0 4px 12px rgba(102, 126, 234, 0.15);
}

/* ==================== 按钮样式 ==================== */

QPushButton {
    background: #667eea;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 10px 20px;
    font-size: 14px;
    font-weight: 500;
}

QPushButton:hover {
    background: #5a6fd6;
}

QPushButton:pressed {
    background: #4e5fc2;
}

QPushButton:disabled {
    background: #cccccc;
    color: #999999;
}

/* 次要按钮 */
QPushButton[secondary="true"] {
    background: #f3f4f6;
    color: #667eea;
    border: 1px solid #cfd6e4;
}

QPushButton[secondary="true"]:hover {
    background: #e9edf5;
    border-color: #667eea;
}

QPushButton[secondary="true"]:pressed {
    background: #dde3ee;
}

QPushButton[compactAction="true"] {
    padding: 6px 14px;
}

QPushButton[smallAction="true"] {
    font-size: 11px;
    padding: 2px 6px;
}

QPushButton[primaryAction="true"] {
    background: #2f80ff;
    color: white;
    border: 1px solid #1f66d1;
    border-radius: 8px;
    font-weight: 600;
}

QPushButton[primaryAction="true"]:hover {
    background: #1f72e8;
    border-color: #1859b8;
}

QPushButton[primaryAction="true"]:pressed {
    background: #195fc4;
    border-color: #144f9f;
}

QPushButton[primaryAction="true"]:disabled {
    background: #d6dde8;
    color: #8c98aa;
    border-color: #c5cfdd;
}

/* ==================== 输入框样式 ==================== */

QLineEdit, QTextEdit, QPlainTextEdit {
    background: white;
    border: 1px solid #ddd;
    border-radius: 6px;
    padding: 10px 12px;
    font-size: 14px;
    color: #333;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border-color: #667eea;
    outline: none;
}

QLineEdit:disabled, QTextEdit:disabled {
    background: #f5f5f5;
    color: #999;
}

QListWidget {
    background: white;
    border: 1px solid #ddd;
    border-radius: 6px;
    padding: 6px;
    font-size: 14px;
}

QListWidget::item {
    min-height: 26px;
    padding: 4px 8px;
}

QListWidget[role="selectedQueryList"] {
    background: white;
    color: #303133;
    border: 1px solid #dcdfe6;
    border-radius: 6px;
    padding: 4px;
    outline: 0;
    selection-background-color: #f2f4f7;
    selection-color: #303133;
}

QListWidget[role="selectedQueryList"]::item {
    min-height: 26px;
    padding: 4px 8px;
    border-radius: 4px;
}

QListWidget[role="selectedQueryList"]::item:selected,
QListWidget[role="selectedQueryList"]::item:selected:active,
QListWidget[role="selectedQueryList"]::item:selected:!active {
    background: #f2f4f7;
    color: #303133;
    border: 1px solid #667eea;
}

QCheckBox {
    color: #303133;
    min-height: 28px;
    spacing: 6px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #dcdfe6;
    border-radius: 4px;
    background: white;
}

QCheckBox::indicator:hover {
    border-color: #2f80ff;
}

QCheckBox::indicator:checked {
    background: #2f80ff;
    border: 1px solid #2f80ff;
}

QCheckBox::indicator:disabled {
    background: #f3f4f6;
    border-color: #cfd6e4;
}

QCheckBox#tableCheckBox {
    min-width: 22px;
    max-width: 22px;
    min-height: 22px;
    max-height: 22px;
    spacing: 0px;
    padding: 0px;
    margin: 0px;
}

QCheckBox#tableCheckBox::indicator {
    width: 18px;
    height: 18px;
    margin: 2px;
}

QCheckBox#tableCheckBox::indicator:checked {
    background: #2f80ff;
    border: 1px solid #2f80ff;
}

QCheckBox#tableCheckBox::indicator:disabled {
    background: #f3f4f6;
    border-color: #cfd6e4;
}

/* ==================== 下拉框样式 ==================== */

QComboBox {
    background: white;
    border: 1px solid #ddd;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 14px;
    min-height: 36px;
}

QComboBox:hover {
    border-color: #667eea;
}

QComboBox:focus {
    border-color: #667eea;
}

QComboBox::drop-down {
    border: none;
    width: 30px;
}

QComboBox::down-arrow {
    width: 12px;
    height: 12px;
}

QComboBox QAbstractItemView {
    background: white;
    color: #303133;
    border: 1px solid #ddd;
    border-radius: 6px;
    outline: 0;
    selection-background-color: #667eea;
    selection-color: white;
}

QComboBox QAbstractItemView::item {
    background: white;
    color: #303133;
    min-height: 28px;
    padding: 4px 10px;
}

QComboBox QAbstractItemView::item:hover {
    background: #f2f4f7;
    color: #303133;
}

QComboBox QAbstractItemView::item:selected {
    background: #667eea;
    color: white;
}

/* ==================== 滑块样式 ==================== */

QSlider::groove:horizontal {
    height: 6px;
    background: #e0e0e0;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    width: 18px;
    height: 18px;
    margin: -6px 0;
    background: #667eea;
    border-radius: 9px;
}

QSlider::handle:horizontal:hover {
    background: #5a6fd6;
}

QSlider::sub-page:horizontal {
    background: #667eea;
    border-radius: 3px;
}

/* ==================== 进度条样式 ==================== */

QProgressBar {
    background: #e0e0e0;
    border: none;
    border-radius: 4px;
    height: 8px;
    text-align: center;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #667eea, stop:1 #764ba2);
    border-radius: 4px;
}

/* ==================== 表格样式 ==================== */

QTableWidget, QTableView {
    background: white;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    gridline-color: #f0f0f0;
}

QTableWidget::item, QTableView::item {
    padding: 8px;
}

QTableWidget::item:selected, QTableView::item:selected {
    background: rgba(102, 126, 234, 0.15);
    color: #333;
}

QHeaderView::section {
    background: #f8f9fa;
    border: none;
    border-bottom: 1px solid #e0e0e0;
    padding: 10px;
    font-weight: 600;
    color: #666;
}

/* ==================== 滚动条样式 ==================== */

QScrollBar:vertical {
    background: #f5f5f5;
    width: 10px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background: #ccc;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #bbb;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: #f5f5f5;
    height: 10px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal {
    background: #ccc;
    border-radius: 5px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: #bbb;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ==================== 标签页样式 ==================== */

QTabWidget::pane {
    background: white;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    padding: 10px;
}

QTabBar::tab {
    background: #f5f5f5;
    border: none;
    padding: 10px 20px;
    margin-right: 2px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

QTabBar::tab:selected {
    background: white;
    color: #667eea;
    font-weight: 600;
}

QTabBar::tab:hover:!selected {
    background: #e8e8e8;
}

/* ==================== 工具提示样式 ==================== */

QToolTip {
    background: #333;
    color: white;
    border: none;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 12px;
}

/* ==================== 状态栏样式 ==================== */

QStatusBar {
    background: #f0f0f0;
    color: #666;
    border-top: 1px solid #e0e0e0;
    padding: 5px 10px;
}

/* ==================== 对话框样式 ==================== */

QDialog {
    background-color: white;
    color: #303133;
}

QMessageBox {
    background-color: white;
    color: #303133;
}

QDialog QWidget, QMessageBox QWidget {
    background-color: white;
    color: #303133;
}

QDialog QLabel, QMessageBox QLabel {
    background-color: white;
    color: #303133;
}

QMessageBox * {
    background-color: white;
    color: #303133;
}

QMessageBox QPushButton {
    background-color: #f3f4f6;
    color: #667eea;
    border: 1px solid #cfd6e4;
    border-radius: 6px;
    padding: 6px 18px;
    min-width: 80px;
}

QMessageBox QPushButton:hover {
    background-color: #e9edf5;
    border-color: #667eea;
}

/* ==================== 分组框样式 ==================== */

QGroupBox {
    background: white;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    margin-top: 15px;
    padding-top: 15px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 15px;
    padding: 0 5px;
    color: #333;
}

/* ==================== 标签样式 ==================== */

QLabel {
    color: #333;
}

QLabel[heading="true"] {
    font-size: 18px;
    font-weight: bold;
    color: #333;
}

QLabel[subheading="true"] {
    font-size: 14px;
    color: #666;
}

QLabel[error="true"] {
    color: #e74c3c;
}

QLabel[success="true"] {
    color: #27ae60;
}
